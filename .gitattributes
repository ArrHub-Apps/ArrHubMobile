# Normalize all text files to LF in the repository.
# Prevents phantom CRLF-only diffs on Windows checkouts.
* text=auto eol=lf

# Explicitly binary assets (never touch line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.jar   binary
*.keystore binary
*.jks   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
